# Copy this file to .env before running docker compose up.
# Never commit a real .env with secrets.

ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=distributed-search-engine
API_V1_PREFIX=/api/v1

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://search:search@postgres:5432/search_engine
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300
CACHE_ENABLED=true

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://elasticsearch-node-1:9200
ELASTICSEARCH_HOSTS=["http://elasticsearch-node-1:9200","http://elasticsearch-node-2:9200","http://elasticsearch-node-3:9200"]
ELASTICSEARCH_INDEX=documents
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_TIMEOUT=10
ELASTICSEARCH_MAX_RETRIES=3

# --- Indexing ---
INDEXING_BATCH_SIZE=500
INDEXING_MAX_CONCURRENCY=4
INDEXING_MAX_RETRIES=5
INDEXING_RETRY_BASE_DELAY_SECONDS=0.5

# --- Search ---
SEARCH_DEFAULT_PAGE_SIZE=20
SEARCH_MAX_PAGE_SIZE=100
SEARCH_REQUEST_TIMEOUT_SECONDS=5.0

# --- Rate limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=300
